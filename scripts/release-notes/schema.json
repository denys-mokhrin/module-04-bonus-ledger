{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "release_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "previous_tag": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "enum": ["Added", "Changed", "Fixed", "Removed"] },
          "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["title", "items"]
      }
    }
  },
  "required": ["version", "release_date", "previous_tag", "sections"]
}
