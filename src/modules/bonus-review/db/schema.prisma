// Prisma schema of the bonus-review context: tables of the "bonus_review" Postgres schema only (ADR 0002).
// The connection URL comes from prisma.config.ts, which appends ?schema=bonus_review.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}
