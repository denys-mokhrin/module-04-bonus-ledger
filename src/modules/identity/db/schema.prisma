// Prisma schema of the identity context: tables of the "identity" Postgres schema only (ADR 0002).
// The connection URL comes from prisma.config.ts, which appends ?schema=identity.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// A group of members with one team lead (docs/bc-map.md). Belongs to one Company (the tenant).
/// Ids and createdAt are set by the application (newId(), Clock), never by the database (ADR 0002).
model Team {
  id           String   @id @db.Uuid
  /// Tenant id. No foreign key yet: Company does not exist. Once it does (same identity schema), add one.
  companyId    String   @db.Uuid
  name         String
  /// Member id only; Member does not exist yet, so no relation.
  leadMemberId String?  @db.Uuid
  /// UTC.
  createdAt    DateTime @db.Timestamptz(3)
  members      Member[]

  @@unique([companyId, name])
  @@map("team")
}

/// Role of a member in the team (docs/bc-map.md); it feeds the Weighting Policy in Contribution Scoring.
enum MemberRole {
  Dev
  QA
  Lead
  PM
}

/// A person whose contribution is scored (docs/bc-map.md). Belongs to one Team and one Company (the tenant).
/// Ids and createdAt are set by the application (newId(), Clock), never by the database (ADR 0002).
model Member {
  id          String     @id @db.Uuid
  /// Tenant id. No foreign key yet: Company does not exist. Once it does (same identity schema), add one.
  companyId   String     @db.Uuid
  /// Same identity schema, so a real foreign key to team.
  teamId      String     @db.Uuid
  team        Team       @relation(fields: [teamId], references: [id])
  /// Unique inside a team, not across the company.
  displayName String
  role        MemberRole
  /// UTC.
  createdAt   DateTime   @db.Timestamptz(3)

  @@unique([teamId, displayName])
  @@map("member")
}

/// An HR user who approves justifications; is not scored (docs/bc-map.md). Belongs to one Company (the tenant).
/// Ids and createdAt are set by the application (newId(), Clock), never by the database (ADR 0002).
model Reviewer {
  id          String   @id @db.Uuid
  /// Tenant id. No foreign key yet: Company does not exist. Once it does (same identity schema), add one.
  companyId   String   @db.Uuid
  displayName String
  /// Unique inside a company, not globally. The unique index is case-sensitive:
  /// the application normalises the email (trim, lower case) before saving and before lookups.
  email       String
  /// UTC.
  createdAt   DateTime @db.Timestamptz(3)

  @@unique([companyId, email])
  @@map("reviewer")
}
