// Prisma schema of the identity context: tables of the "identity" Postgres schema only (ADR 0002).
// The connection URL comes from prisma.config.ts, which appends ?schema=identity.

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}
